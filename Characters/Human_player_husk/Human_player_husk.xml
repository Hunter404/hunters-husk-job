  <Character
    SpecifierTags="True"
    SpeciesName="Human_player_husk"
    VariantOf="Human"
    SpeciesTranslationOverride="human"
    DisplayName=""
    Group="human"
    Humanoid="True"
    HasInfo="True"
    HasCharacterInfo="True"
    CanInteract="True"
    CanClimb="True"
    ForceSlowClimbing="False"
    Husk="False"
    UseHuskAppendage="True"
    HuskedSpecies="Human_player_husk"
    UseHumanAI="True"
    CanSpeak="False"
    ShowHealthBar="True"
    UseBossHealthBar="False"
    NeedsAir="False"
    NeedsWater="False"
    CanEat="True"
    UsePathFinding="True"
    HideInThermalGoggles="True"
    BloodDecal="blackblood"
    BleedParticleAir="blackblooddrop"
    BleedParticleWater="blackwaterblood"
    DistantSonarRange="0"
    SoundInterval="10"
    DrawLast="False"
    AITurretPriority="1"
    AISlowTurretPriority="1"
    DespawnContainer="">
    <!-- 1.2: replaces Human's <names> (index 0) with the pack's husk names (only used for generated characters) -->
    <names path="%ModDir%/names.xml" />
    <ragdolls folder="default" />
    <animations folder="default" />
    <!-- Husk appendage used by the hh_humanhusksymbiosis affliction (AfflictionHusk.AttachHuskAppendage) -->
    <huskappendage affliction="hh_humanhusksymbiosis" path="Content/Characters/Humanhusk/Huskappendagesymbiosis.xml" />
    <!-- Human's first damageemitter / both bloodemitters / first gibemitter: husk black blood and gibs -->
    <damageemitter particle="blackgib" />
    <bloodemitter particle="blackblood" />
    <bloodemitter particle="blackwaterblood" />
    <gibemitter particle="blackgib" />
    <!-- 1.4: Human's limbs and MedUI sprites are kept; only these attributes change -->
    <health vitality="125" minvitality="-100" usehealthwindow="True" constanthealthregeneration="0" healthregenerationwheneating="1" bleedingreduction="5" />
    <!-- 1.3: humanoid inventory line (same as Human, written out per the checklist) -->
    <inventory arrowslot="9" Slots="Card, Headset, Head, InnerClothes, OuterClothes, LeftHand, RightHand, Bag, Any, Any, Any, Any, Any, Any, Any, Any, Any, Any, HealthInterface" AccessibleWhenAlive="True" Commonness="1" />
